{
  "mcpServers": {
    "elevai-connect": {
      "command": "node",
      "args": [
        "./mcp-server/dist/index.js"
      ],
      "env": {
        "PROJECT_ROOT": ".",
        "PULUMI_SKIP_UPDATE_CHECK": "true"
      },
      "autoApprove": [
        "pulumi_preview",
        "pulumi_stack_list",
        "pulumi_stack_output",
        "pulumi_config_get",
        "read_stack_config",
        "list_custom_modules",
        "get_project_structure"
      ],
      "disabled": false
    },
    "awslabs.aws-api-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "eu-west-2"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}