# ============================================================================
# PULUMI AMAZON CONNECT INFRASTRUCTURE - EXAMPLE CONFIGURATION
# ============================================================================
# Copy this file to Pulumi.dev.yaml (or Pulumi.prod.yaml, etc.) and 
# customize with your environment-specific values
#
# Quick Start:
#   cp Pulumi.dev.yaml.example Pulumi.dev.yaml
#   # Then edit Pulumi.dev.yaml with your settings
# ============================================================================

config:
  # --------------------------------------------------------------------------
  # ENVIRONMENT & AWS CONFIGURATION
  # --------------------------------------------------------------------------
  environment:type: dev  # dev, staging, prod, etc.
  aws:region: us-east-1
  aws-native:region: us-east-1
  aws-account-id: "000000000000"

  # --------------------------------------------------------------------------
  # ALERTING & NOTIFICATIONS
  # --------------------------------------------------------------------------
  alerting:enabled: true
  alerting:info_warning_email: your-email@example.com
  alerting:error_email: your-email@example.com

  # --------------------------------------------------------------------------
  # AWS BILLING ALERTS
  # --------------------------------------------------------------------------
  billing:enabled: true
  billing:monthlyBudgetLimit: 50
  billing:alertThresholds: [50, 80, 100]
  billing:notificationEmail: your-email@example.com

  # --------------------------------------------------------------------------
  # CLOUDWATCH ALARM THRESHOLDS
  # --------------------------------------------------------------------------
  alarms:lambda:
    errors:
      threshold: 5
      period: 300
      evaluationPeriods: 2
    throttles:
      threshold: 10
      period: 300
      evaluationPeriods: 1
    duration:
      threshold: 25000
      period: 300
      evaluationPeriods: 2
    concurrentExecutions:
      threshold: 100
      period: 60
      evaluationPeriods: 2

  alarms:dynamodb:
    readThrottles:
      threshold: 10
      period: 300
      evaluationPeriods: 2
    writeThrottles:
      threshold: 10
      period: 300
      evaluationPeriods: 2
    userErrors:
      threshold: 20
      period: 300
      evaluationPeriods: 1
    consumedReadCapacity:
      threshold: 8000
      period: 300
      evaluationPeriods: 2

  alarms:connect:
    concurrentPercentageWarning: 70
    concurrentPercentageCritical: 85
    concurrentPeriod: 60
    concurrentEvaluationPeriodsWarning: 3
    concurrentEvaluationPeriodsCritical: 2
    missedCalls:
      threshold: 5
      period: 300
      evaluationPeriods: 1
    throttledCalls:
      threshold: 1
      period: 300
      evaluationPeriods: 1
    contactFlowErrors:
      threshold: 5
      period: 300
      evaluationPeriods: 2
    callRecordingUploadError:
      threshold: 1
      period: 300
      evaluationPeriods: 1
    contactFlowFatalErrors:
      threshold: 1
      period: 300
      evaluationPeriods: 1
    misconfiguredPhoneNumbers:
      threshold: 1
      period: 300
      evaluationPeriods: 1
    queueCapacityExceededError:
      threshold: 1
      period: 300
      evaluationPeriods: 2
    toInstancePacketLossRate:
      threshold: 20
      period: 60
      evaluationPeriods: 2

  alarms:sqs:
    dlqMessages:
      threshold: 1
      period: 300
      evaluationPeriods: 1
    dlqMessageAge:
      threshold: 3600
      period: 300
      evaluationPeriods: 2

  alarms:kinesisDataStreams:
    iteratorAgeMilliseconds:
      threshold: 43200000  # 12 hours 
      period: 300
      evaluationPeriods: 2
    readThroughputExceeded:
      threshold: 0.01  # 1% of requests throttled
      period: 300
      evaluationPeriods: 2
    writeThroughputExceeded:
      threshold: 0.01  # 1% of requests throttled
      period: 300
      evaluationPeriods: 2
    putRecordsSuccess:
      threshold: 0.95  # 95% success rate
      period: 300
      evaluationPeriods: 2
    getRecordsSuccess:
      threshold: 0.95  # 95% success rate
      period: 300
      evaluationPeriods: 2

  alarms:kinesisVideoStreams:
    getMediaConnectionErrors:
      threshold: 5  # Connection errors when retrieving streams
      period: 300
      evaluationPeriods: 2
    putMediaConnectionErrors:
      threshold: 5  # Connection errors when streaming to KVS
      period: 300
      evaluationPeriods: 2
    putMediaErrorAckCount:
      threshold: 10  # Fragment acknowledgment errors from KVS
      period: 300
      evaluationPeriods: 2

  # --------------------------------------------------------------------------
  # AMAZON CONNECT INSTANCE
  # --------------------------------------------------------------------------
  # ⚠️  WARNING: instanceAlias and identityManagementType CANNOT be changed once created!
  connect:instanceAlias: your-unique-alias  # MUST BE UNIQUE globally
  connect:identityManagementType: SAML      # SAML or CONNECT_MANAGED
  connect:multiPartyConferenceEnabled: true
  connect:contactFlowLogsEnabled: true
  connect:contactLensEnabled: true
  # Optional: SAML metadata file path (only if using SAML)
  # connect:samlMetadataFile: ./path/to/saml/metadata.xml
  
  # Approved origins for CCP embedding
  connect:approvedOrigins:
    - http://localhost:3000        # Local development
    - https://your-app.example.com # Production

  # --------------------------------------------------------------------------
  # CLOUDWATCH LOG RETENTION
  # --------------------------------------------------------------------------
  cloudwatch:logRetentionDays: 30  # 0 = never expire; common: 7, 14, 30, 60, 90, 180, 365

  # --------------------------------------------------------------------------
  # S3 LIFECYCLE POLICIES
  # --------------------------------------------------------------------------
  s3:archiveDays: 90      # Default archive transition days
  s3:deletionDays: 365    # Default deletion days
  s3:recordings:
    archiveDays: 90
    deletionDays: 2555  # 7 years for compliance
  s3:chatTranscripts:
    archiveDays: 90
    deletionDays: 365
  s3:exportedReports:
    archiveDays: 30
    deletionDays: 180
  s3:attachments:
    archiveDays: 90
    deletionDays: 365
  s3:screenRecordings:
    archiveDays: 90
    deletionDays: 365
  s3:contactEvaluations:
    archiveDays: 90
    deletionDays: 1095
  s3:emailMessages:
    archiveDays: 90
    deletionDays: 365
  s3:connectAthenaQueries:
    archiveDays: 91
    deletionDays: 90

  # --------------------------------------------------------------------------
  # AMAZON ATHENA
  # --------------------------------------------------------------------------
  athena:bytesScannedCutoff: 5368709120  # 5GB query size limit

  # --------------------------------------------------------------------------
  # KINESIS VIDEO STREAMS
  # --------------------------------------------------------------------------
  # Amazon Connect Kinesis Video Streams enables real-time audio and video
  # streaming from customer interactions for recording, analytics, and monitoring.
  #
  # When enabled, Amazon Connect creates Kinesis Video Streams automatically
  # for each active call, allowing you to:
  # - Stream live audio for real-time sentiment analysis
  # - Record customer conversations for quality monitoring
  # - Integrate with ML services for transcription and analytics
  # - Archive audio for compliance requirements
  #
  # Configuration:
  # - enabled: true/false - Enable KVS for live media streaming (Default: true)
  # - prefix: Prefix for KVS stream names (Default: "elevai")
  # - retentionPeriodHours: Hours to retain video data (0 = no retention, max: 87600)
  #
  # Note: KVS is typically used for real-time streaming. For long-term storage,
  # consider using S3 buckets with the recordings configuration above.
  kinesisVideoStream:enabled: true
  kinesisVideoStream:prefix: elevai
  kinesisVideoStream:retentionPeriodHours: 168  # 7 days

  # --------------------------------------------------------------------------
  # DATA STREAMING (KINESIS)
  # --------------------------------------------------------------------------
  # Amazon Connect can stream contact trace records and agent events to 
  # Kinesis data streams for real-time processing and analytics.
  #
  # Configuration options:
  # - enabled: true/false - Enable or disable the stream
  # - type: "on-demand" or "provisioned"
  #   * on-demand: AWS manages capacity automatically (recommended for variable workloads)
  #   * provisioned: You specify shard count (use for predictable, high-volume workloads)
  # - shards: Number of shards (only applicable for type: provisioned)
  # - retention: Data retention period in days (1-7)
  #
  # Cost considerations:
  # - On-demand: ~$0.04 per GB written + $0.04 per GB read
  # - Provisioned: ~$0.015 per shard-hour + data transfer costs
  dataStreaming:contactRecords:
    enabled: false
    type: on-demand      # on-demand or provisioned
    shards: 1           # Only used if type is provisioned
    retention: 1        # Days (1-7)
  dataStreaming:agentEvents:
    enabled: false
    type: on-demand      # on-demand or provisioned
    shards: 1           # Only used if type is provisioned
    retention: 1        # Days (1-7)

  # --------------------------------------------------------------------------
  # AMAZON Q IN CONNECT (QConnect)
  # --------------------------------------------------------------------------
  qconnect:enabled: true
  qconnect:assistantName: q-assistant
  qconnect:knowledgeBaseName: q-knowledgebase
  qconnect:contentTagging:
    - folderName: sales/emea
      tags:
        Department: Sales
        Region: EMEA
        Stage: Dev
    - folderName: sales/americas
      tags:
        Department: Sales
        Region: Americas
    - folderName: support
      tags:
        Department: Support
        ContentType: Guide
    - folderName: policies
      tags:
        Department: Compliance
        ContentType: Policy
        Compliance: Required

  # --------------------------------------------------------------------------
  # CUSTOMER PROFILES
  # --------------------------------------------------------------------------
  # Amazon Connect Customer Profiles creates unified customer profiles by
  # combining data from multiple applications and contact channels.
  # 
  # When enabled, this creates:
  # - Customer Profiles domain (connect-profiles-domain)
  # - Optional SQS error reporting queue
  # - Integration with Amazon Connect instance
  # - Parameter Store entries for external integration
  #
  # Cost: ~$50-200/month depending on call volume
  customerProfiles:enabled: true
  # Auto-association type controls how profiles are created and linked to contacts
  # Options:
  #   CREATE_LIMITED_PROFILES_AND_AUTO_ASSOCIATE - (Recommended/Default)
  #     Automatically creates limited profiles from Contact Trace Records (CTRs)
  #     and associates contacts with profiles. Best for most use cases.
  #   
  #   AUTO_ASSOCIATE_PROFILES_ONLY - 
  #     Only associates contacts with existing profiles, doesn't create new ones.
  #     Use when profiles are created from other sources (CRM, data warehouse).
  #   
  #   CREATE_INFERRED_PROFILES_ONLY - 
  #     Creates inferred profiles without auto-association.
  #     For advanced analytics and ML use cases.
  customerProfiles:autoAssociationType: CREATE_LIMITED_PROFILES_AND_AUTO_ASSOCIATE
  
  # Enable SQS error reporting queue (Recommended for production)
  customerProfiles:errorQueue: false
  
  # Profile expiration in days (max 1098 days)
  customerProfiles:defaultExpirationDays: 366
