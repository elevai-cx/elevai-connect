    "name": "Elevai Vmail",
    "description": "Voicemail capture module — records a message and tags the contact",
    "status": "published",
    "settings": {
      "input": {
        "schema": {
          "type": "object",
          "properties": {
            "elevai-vmail-destination-channel": {
              "type": "string",
              "default": "task",
              "description": "Support for \"task\" or \"case\""
            },
            "elevai-vmail-queue-arn": {
              "type": "string"
            },
            "elevai-vmail-customer-id": {
              "type": "string",
              "description": "OPTIONAL - Customer profile ARN for case creation"
            },
            "elevai-vmail-genai-summary": {
              "type": "string",
              "default": "true",
              "description": "OPTIONAL - Enable GenAI summary generation using Amazon Bedrock. Pass \"true\" to enable."
            },
            "elevai-vmail-genai-prompt": {
              "type": "string",
              "default": "",
              "description": "OPTIONAL - Custom prompt for GenAI summary generation"
            },
            "elevai-vmail-terminating-key": {
              "type": "string",
              "description": "Enter terminating key press such as '1' or '9' or '?' for any",
              "minLength": 1,
              "maxLength": 1,
              "default": "?"
            },
            "elevai-vmail-agent-arn": {
              "type": "string"
            },
            "elevai-vmail-loops": {
              "type": "string",
              "default": "3",
              "minLength": 1,
              "maxLength": 2
            }
          },
          "required": [
            "elevai-vmail-destination-channel"
          ]
        }
      }
    },
