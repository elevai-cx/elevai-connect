        "type": "default",
        "id": "958755de-6b03-4df7-b422-a9236bb76e95",
        "content": "This module is for voicemail recording. The module requires parameters based on the destination type.\n\nThe module is language agnostic as it plays a beep and handles the recording only. All messages are to be played within the calling flow.",
        "actionId": "",
        "isFolded": false,
        "position": {
          "x": -606,
          "y": 54
        },
        "size": {
          "height": 295,
          "width": 300
        }
      },
      {
        "type": "default",
        "id": "4eb3bfa2-df2d-45ff-af97-ac225be8e9aa",
        "content": "Required parameters:\n\nFor TASKS\n\n- elevai-vmail-destination-channel = task\n- elevai-vmail-queue-arn = [arn] OR elevai-vmail-agent-arn = [arn]\n\n\nfor CASES\n\n- elevai-vmail-destination-channel = case\n- elevai-vmail-queue-arn = [arn] OR elevai-vmail-agent-arn = [arn]\n- elevai-vmail-customer-id = [profile_id]",
        "actionId": "",
        "isFolded": false,
        "position": {
